{
  "$id": "https://github.com/Vinayak19112003/muse-takeone/schema/reconstruction.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "action": {
      "oneOf": [
        {
          "$ref": "#/definitions/click"
        },
        {
          "$ref": "#/definitions/type"
        },
        {
          "$ref": "#/definitions/scroll"
        },
        {
          "$ref": "#/definitions/hover"
        },
        {
          "$ref": "#/definitions/wait"
        }
      ],
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "click": {
      "additionalProperties": false,
      "properties": {
        "clickHoldMs": {
          "default": 130,
          "minimum": 0,
          "type": "number"
        },
        "kind": {
          "const": "click"
        },
        "nextFrameAfterMs": {
          "default": 200,
          "description": "How soon after mouseup the next screenshot appears. Only the frame's last action uses this.",
          "minimum": 0,
          "type": "number"
        },
        "pauseMs": {
          "default": 700,
          "description": "Pause after mouseup before the next action.",
          "minimum": 0,
          "type": "number"
        },
        "preClickMs": {
          "default": 120,
          "description": "Settle pause after the cursor arrives, before mousedown.",
          "minimum": 0,
          "type": "number"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "kind",
        "x",
        "y"
      ]
    },
    "frame": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/definitions/action"
          },
          "type": "array"
        },
        "caption": {
          "description": "Narrative caption shown while this frame is up.",
          "type": "string"
        },
        "file": {
          "description": "Screenshot file name inside screenshotsDir. Base names must be unique.",
          "type": "string"
        },
        "holdMs": {
          "description": "Minimum time the screenshot stays up. Default 2600 with no actions, 0 with actions (the choreography drives the cut). Use a wait action for storytelling beats.",
          "minimum": 0,
          "type": "number"
        },
        "redactions": {
          "$ref": "#/definitions/redactions",
          "description": "Regions redacted from this frame only (in addition to global redactions)."
        },
        "transitionIn": {
          "description": "How the video arrives at THIS frame. A scroll at the end of the previous frame auto-selects a slide.",
          "oneOf": [
            {
              "enum": [
                "crossfade",
                "cut"
              ]
            },
            {
              "additionalProperties": false,
              "properties": {
                "dx": {
                  "description": "Source px the old screenshot slides horizontally.",
                  "type": "number"
                },
                "dy": {
                  "description": "Source px the old screenshot slides vertically.",
                  "type": "number"
                },
                "kind": {
                  "const": "slide"
                }
              },
              "required": [
                "kind",
                "dx",
                "dy"
              ],
              "type": "object"
            }
          ]
        }
      },
      "required": [
        "file"
      ],
      "type": "object"
    },
    "hover": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "hover"
        },
        "nextFrameAfterMs": {
          "default": 200,
          "minimum": 0,
          "type": "number"
        },
        "pauseMs": {
          "default": 800,
          "description": "Dwell while hovering (lets the tooltip/menu appear).",
          "minimum": 0,
          "type": "number"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "kind",
        "x",
        "y"
      ]
    },
    "redactions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "height": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "mode": {
            "enum": [
              "blur",
              "solid",
              "pixelate"
            ],
            "type": "string"
          },
          "width": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "required": [
          "x",
          "y",
          "width",
          "height",
          "mode"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "scroll": {
      "additionalProperties": false,
      "properties": {
        "durationMs": {
          "default": 600,
          "minimum": 0,
          "type": "number"
        },
        "dx": {
          "default": 0,
          "type": "number"
        },
        "dy": {
          "default": 700,
          "type": "number"
        },
        "kind": {
          "const": "scroll"
        },
        "nextFrameAfterMs": {
          "default": 200,
          "minimum": 0,
          "type": "number"
        },
        "pauseMs": {
          "default": 500,
          "minimum": 0,
          "type": "number"
        },
        "x": {
          "description": "Where the cursor rests during the scroll.",
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "kind"
      ]
    },
    "type": {
      "additionalProperties": false,
      "properties": {
        "cpm": {
          "default": 240,
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "kind": {
          "const": "type"
        },
        "nextFrameAfterMs": {
          "default": 200,
          "minimum": 0,
          "type": "number"
        },
        "pauseMs": {
          "default": 700,
          "minimum": 0,
          "type": "number"
        },
        "sensitive": {
          "default": false,
          "description": "Password/secret input: hides the keyboard HUD by default. Never put real secrets in a demo.",
          "type": "boolean"
        },
        "showKeys": {
          "default": true,
          "description": "Show typed text in the keyboard HUD. Set false for anything the viewer should not read.",
          "type": "boolean"
        },
        "text": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "kind",
        "x",
        "y",
        "text"
      ]
    },
    "wait": {
      "additionalProperties": false,
      "properties": {
        "durationMs": {
          "description": "Explicit viewer pause (storytelling beat), separate from transition delays.",
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "kind": {
          "const": "wait"
        },
        "nextFrameAfterMs": {
          "default": 120,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "kind",
        "durationMs"
      ]
    },
    "cameraShot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "number",
          "description": "Source ms: the camera begins moving toward this shot. Get the timeline from tracereel inspect (each frame's @Ns timestamp)."
        },
        "end": {
          "type": "number",
          "description": "Source ms: the shot ends."
        },
        "cx": {
          "type": "number",
          "description": "Shot centre x in viewport CSS px."
        },
        "cy": {
          "type": "number",
          "description": "Shot centre y in viewport CSS px."
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Shot scale, e.g. 1.35."
        },
        "transitionDuration": {
          "type": "number",
          "description": "Move duration into this shot, in output ms. Defaults to the reconstruction config."
        },
        "easing": {
          "type": "string",
          "description": "Easing into this shot. Defaults to the zoom config easing."
        }
      },
      "required": [
        "start",
        "end",
        "cx",
        "cy",
        "scale"
      ]
    }
  },
  "description": "TraceReel Trace Format v1: states and actions describing what an AI agent did in a browser, plus the screenshots of each state. TraceReel normalizes the trace through the agent adapter, synthesizes the cursor, clicks, typing and camera work, and renders a polished 1080p60 MP4.",
  "properties": {
    "frames": {
      "description": "The workflow as states: each frame is one screenshot (one UI state) plus the actions performed while it is on screen. The next frame shows the result.",
      "items": {
        "$ref": "#/definitions/frame"
      },
      "minItems": 1,
      "type": "array"
    },
    "motion": {
      "additionalProperties": false,
      "description": "Cursor glide tuning overrides.",
      "properties": {
        "maxMs": {
          "default": 1100,
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "minMs": {
          "default": 420,
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "msPerPx": {
          "default": 0.55,
          "exclusiveMinimum": 0,
          "type": "number"
        }
      },
      "type": "object"
    },
    "redactions": {
      "$ref": "#/definitions/redactions",
      "description": "Regions redacted from EVERY frame before rendering."
    },
    "screenshotsDir": {
      "default": ".",
      "description": "Directory holding the screenshots, resolved relative to the input file.",
      "type": "string"
    },
    "source": {
      "additionalProperties": false,
      "description": "Capture provenance. Declarative, not cryptographic: nothing in a PNG proves which tool wrote it. Use --require-source to enforce the type.",
      "properties": {
        "captureTool": {
          "description": "What captured the screenshots, e.g. \"muse\".",
          "type": "string"
        },
        "capturedAt": {
          "description": "ISO 8601 timestamp of the capture session.",
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "session": {
          "description": "Which session the screenshots came from, e.g. \"main\".",
          "type": "string"
        },
        "type": {
          "enum": [
            "agent-browser",
            "muse-managed-browser",
            "external-browser",
            "manual-screenshots"
          ],
          "type": "string",
          "description": "\"agent-browser\" is the Trace Format v1 provenance (agent named in source.agent). The other values are legacy/deprecated: \"muse-managed-browser\" normalizes to agent-browser/muse."
        },
        "viewport": {
          "additionalProperties": false,
          "properties": {
            "height": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "width": {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          },
          "required": [
            "width",
            "height"
          ],
          "type": "object"
        },
        "agent": {
          "type": "string",
          "description": "Free-form agent name, required when type is \"agent-browser\" (e.g. \"muse\", \"grokbot\"). Never affects rendering."
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "version": {
      "const": 1,
      "description": "Schema version. Currently 1."
    },
    "viewport": {
      "additionalProperties": false,
      "description": "Viewport CSS size the screenshots were captured at. Must match input.source.viewport when both are set.",
      "properties": {
        "height": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "type": "number"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "type": "object"
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/cameraShot"
      },
      "description": "Explicit camera shots, overriding the automatic shot planner entirely. Times are in source ms (see tracereel inspect)."
    },
    "states": {
      "type": "array",
      "description": "UI states in capture order. Preferred form; do not mix with \"frames\".",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "screenshot"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique state name within the trace."
          },
          "screenshot": {
            "type": "string",
            "description": "Screenshot file, relative to screenshotsDir."
          },
          "caption": {
            "type": "string",
            "description": "Caption bar text shown while the state is up."
          },
          "holdMs": {
            "type": "number",
            "description": "Rest time before the next action begins. Default 1200."
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "description": "Actions between states. Requires \"states\". Each action names the state it starts from (from) and, when it changes the UI, the state it lands on (to).",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "from"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "click",
              "type",
              "scroll",
              "hover",
              "wait"
            ]
          },
          "from": {
            "type": "string",
            "description": "State id the action starts from."
          },
          "to": {
            "type": "string",
            "description": "State id the action lands on. Strongly recommended after UI-changing actions."
          },
          "stateDelayMs": {
            "type": "number",
            "description": "Beat between the action finishing and the next state appearing. Default 600."
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "text": {
            "type": "string"
          },
          "dx": {
            "type": "number"
          },
          "dy": {
            "type": "number"
          },
          "durationMs": {
            "type": "number"
          },
          "preClickMs": {
            "type": "number"
          },
          "clickHoldMs": {
            "type": "number"
          },
          "pauseMs": {
            "type": "number"
          },
          "nextFrameAfterMs": {
            "type": "number"
          },
          "cpm": {
            "type": "number"
          },
          "showKeys": {
            "type": "boolean"
          },
          "sensitive": {
            "type": "boolean"
          },
          "dwellMs": {
            "type": "number"
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "description": "What the capturing agent could express. Adapters fill defaults; explicit declarations win.",
      "properties": {
        "screenshots": {
          "type": "boolean"
        },
        "clickCoordinates": {
          "type": "boolean"
        },
        "typingCoordinates": {
          "type": "boolean"
        },
        "scrollEvents": {
          "type": "boolean"
        },
        "hoverEvents": {
          "type": "boolean"
        },
        "videoSegments": {
          "type": "boolean"
        },
        "cursorFreeScreenshots": {
          "type": "boolean"
        }
      }
    },
    "videoSegments": {
      "type": "array",
      "description": "RESERVED: accepted and validated, but not rendered. The renderer works from screenshots only.",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "version",
    "viewport"
  ],
  "title": "TraceReel trace input",
  "type": "object",
  "anyOf": [
    {
      "required": [
        "states"
      ],
      "description": "Preferred: states + actions form."
    },
    {
      "required": [
        "frames"
      ],
      "description": "Legacy: frames with embedded actions."
    }
  ]
}
