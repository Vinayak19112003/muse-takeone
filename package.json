{
  "author": "Vinayak Deshmuk",
  "bin": {
    "tracereel": "./dist/cli.js",
    "takeone": "./dist/cli.js",
    "muse-takeone": "./dist/cli.js"
  },
  "bugs": {
    "url": "https://github.com/Vinayak19112003/tracereel/issues"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13"
  },
  "description": "TraceReel turns AI-agent browser traces into polished demo videos: normalize any agent's trace, reconstruct the interaction timeline, render smooth 1080p60 MP4. Muse is the first integration.",
  "devDependencies": {
    "@types/node": "^26.6.0",
    "ajv": "^8.17.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "schema",
    "skills/tracereel/SKILL.md",
    "skills/adapters/muse/SKILL.md",
    "docs",
    "examples"
  ],
  "homepage": "https://github.com/Vinayak19112003/tracereel#readme",
  "keywords": [
    "tracereel",
    "ai-agent",
    "browser-automation",
    "demo-video",
    "screen-recording",
    "video",
    "typescript",
    "ffmpeg",
    "cursor",
    "reconstruction"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "name": "tracereel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vinayak19112003/tracereel.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "prebuild": "npm run scrollplan:inline",
    "scrollplan:inline": "node scripts/inline-scrollplan.mjs",
    "prepublishOnly": "npm run build",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "visual-qa": "node scripts/visual-qa.mjs",
    "visual-qa:update": "node scripts/visual-qa.mjs --update",
    "fixtures:visual": "node tests/fixtures/visual/gen.mjs"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "0.3.1"
}
